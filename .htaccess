<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Deja pasar archivos y carpetas reales (assets, imágenes, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # SPA fallback: si la ruta no existe, servimos index.html para que la app React maneje
    # el 404 personalizado dentro de la ruta /noticia/... o cualquier otra ruta interna.
    RewriteRule ^ index.html [L]
</IfModule>

DirectoryIndex index.html